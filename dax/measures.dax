-- Supply Chain & Inventory Analytics
-- Power BI DAX Measures
-- Table: supply_chain_data

Total Revenue =
SUM(supply_chain_data[revenue])

Units Sold =
SUM(supply_chain_data[products_sold])

Average Stock =
AVERAGE(supply_chain_data[stock_levels])

Avg Supplier Lead Time =
AVERAGE(supply_chain_data[supplier_lead_time])

Avg Shipping Time =
AVERAGE(supply_chain_data[shipping_time])

Avg Defect Rate =
AVERAGE(supply_chain_data[defect_rate])

-- Percentage display measure:
-- Source defect rates are stored as percentage points.
-- Example: 2.28 source value -> 2.28% display.

Avg Defect Rate % =
DIVIDE(
    AVERAGE(supply_chain_data[defect_rate]),
    100
)

Total Shipping Cost =
SUM(supply_chain_data[shipping_cost])

Avg Manufacturing Cost =
AVERAGE(supply_chain_data[manufacturing_cost])
